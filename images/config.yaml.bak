version: 3
defaults:
  full: Local/qwen3.8:27b-mlx
providers:
  Local:
    kind:
      type: custom_open_ai_compatible
    url: http://localhost:11434/v1
    auth:
      type: static_key
      key: polly
      format: bearer_token
    protocol: openai_chat_completions
models:
  Local/qwen3.8:27b-mlx:
    provider_name: qwen3.8:27b-mlx
    variant: other
    class: full
    provider: Local
    supports_vision: true
    tool_loading: native_deferred
    reasoning:
      type: no_reasoning
    context_window: 32768
  Local/qwen3:8b:
    provider_name: qwen3:8b
    variant: other
    class: mini
    max_output_tokens_per_turn: 32768
    provider: Local
    reasoning:
      type: no_reasoning
    context_window: 32768
##    compaction_threshold: 0.01
  Local/qwen3:1.7b:
    provider_name: qwen3:1.7b
    variant: other
    class: nano
    provider: Local
    reasoning:
      type: no_reasoning
    context_window: 32768
